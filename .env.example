# Puerto del servidor Node.js
PORT=8000

# Base de datos PostgreSQL (si usas el docker-compose.yml provisto)
DATABASE_URL="postgresql://admin:password@localhost:5432/motor_pagos?schema=public"
DIRECT_URL="postgresql://admin:password@localhost:5432/motor_pagos?schema=public"

# Public origin used to build the registered OAuth and Mercado Pago webhook URLs
APP_BASE_URL="https://your-api.example.com"
# 32 random bytes encoded as base64 (generate with: openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=""
# Mercado Pago webhook signature secret configured for this application
MP_WEBHOOK_SECRET=""
# Optional comma-separated browser origins allowed by CORS
CORS_ORIGINS="https://your-platform.example.com"

# Credenciales de Mercado Pago (Globales del Motor, si aplican)
MP_CLIENT_ID=tu_client_id_aca
MP_CLIENT_SECRET=tu_client_secret_aca

# Fase 0 SaaS: solo cuentas de prueba de la cuenta cobradora FivePeaks.
# No usar el token OAuth de Vendor. El script rechaza tokens que no empiecen con TEST-.
MP_SAAS_TEST_ACCESS_TOKEN=""
MP_SAAS_TEST_PAYER_EMAIL=""
MP_SAAS_TEST_BACK_URL="https://your-platform.example.com/subscriptions/return"

# Alta SaaS: mantener desactivado hasta aprobar docs/suscripciones-fase-0.md.
SAAS_SUBSCRIPTIONS_CHECKOUT_ENABLED="false"
# Token propio de FivePeaks, cifrado con TOKEN_ENCRYPTION_KEY y prefijo enc:v1:.
MP_SAAS_ACCESS_TOKEN_ENCRYPTED=""
MP_SAAS_COLLECTOR_ID=""

# Required only when running scripts/seed_client.ts; provide real values via a secret manager.
MI_API_KEY_MAESTRA=""
SEED_WEBHOOK_SECRET=""
SEED_CALLBACK_URL="https://your-platform.example.com/payment-callback"
SEED_REDIRECT_URI="https://your-platform.example.com/settings"
