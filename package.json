{
  "name": "app_pagos",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:conflicts": "tsx scripts/report_migration_conflicts.ts",
    "db:migrate-credentials": "tsx scripts/migrate_credentials.ts",
    "subscriptions:probe": "node --import tsx scripts/probe_saas_subscription.ts",
    "tenant:create": "tsx scripts/create_tenant.ts",
    "tenant:set-subscription-callback": "node --import tsx scripts/set_subscription_callback.ts",
    "test": "tsx --test test/*.test.ts test/unit/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.test.ts",
    "test:all": "npm test && npm run test:integration && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Germanrom/Motor-de-pagos.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Germanrom/Motor-de-pagos/issues"
  },
  "homepage": "https://github.com/Germanrom/Motor-de-pagos#readme",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mercadopago": "^2.12.0",
    "prisma": "^5.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
